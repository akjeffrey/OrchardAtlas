rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photo capture remains deferred; owners may remove existing associated files.
    match /properties/{propertyId}/{path=**} {
      allow delete: if request.auth != null && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
