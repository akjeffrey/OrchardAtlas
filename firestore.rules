rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uuid(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    function owner(propertyId) {
      return signedIn() && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }
    function member(propertyId) {
      return signedIn() && exists(/databases/$(database)/documents/properties/$(propertyId)/members/$(request.auth.uid));
    }
    function reader(propertyId) { return owner(propertyId) || member(propertyId); }
    function writer(propertyId) {
      return owner(propertyId) || (member(propertyId) && get(/databases/$(database)/documents/properties/$(propertyId)/members/$(request.auth.uid)).data.role == 'editor');
    }
    function invited(invitationId, propertyId) {
      let i = get(/databases/$(database)/documents/invitations/$(invitationId)).data;
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == i.email && i.orchard == propertyId
        && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == i.ownerId;
    }
    function text(value) { return value is string && value.size() > 0 && value.size() <= 500; }
    function validItem(d, propertyId) {
      return d.keys().hasAll(['schemaVersion', 'kind', 'name', 'taxonId', 'location', 'createdAt'])
        && d.keys().hasOnly(['schemaVersion', 'kind', 'name', 'taxonId', 'location', 'createdAt', 'plantedOn', 'rootstock', 'nursery', 'notes', 'status', 'accuracyMeters', 'sectionId', 'rowOrder', 'lifeCycle', 'season'])
        && d.schemaVersion == 1 && d.kind == 'managedPlant'
        && text(d.name) && d.taxonId is string && uuid(d.taxonId)
        && d.location is latlng && d.createdAt is timestamp
        && (d.get('plantedOn', null) == null || date(d.plantedOn))
        && d.get('rootstock', '') is string && d.get('rootstock', '').size() <= 500
        && d.get('nursery', '') is string && d.get('nursery', '').size() <= 500
        && d.get('notes', '') is string && d.get('notes', '').size() <= 10000
        && d.get('status', 'active') in ['active', 'archived']
        && d.get('lifeCycle','perennial') in ['perennial','annual']
        && (d.get('season',null)==null || text(d.season))
        && (d.get('lifeCycle','perennial')!='annual' || text(d.get('season','')))
        && (d.get('sectionId', null) == null || (d.sectionId is string && uuid(d.sectionId) && exists(/databases/$(database)/documents/properties/$(propertyId)/sections/$(d.sectionId))))
        && (d.get('rowOrder',null)==null || (d.rowOrder is number && d.rowOrder >= 0 && d.rowOrder <= 1000000000))
        && (d.get('accuracyMeters', null) == null || (d.accuracyMeters is number && d.accuracyMeters >= 0 && d.accuracyMeters <= 100000));
    }
    function date(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function validTask(d, propertyId) {
      return d.keys().hasAll(['schemaVersion', 'title', 'notes', 'itemId', 'dueDate', 'status', 'createdAt'])
        && d.keys().hasOnly(['schemaVersion', 'title', 'notes', 'itemId', 'dueDate', 'status', 'createdAt', 'sectionId', 'cropId', 'groupId', 'groupScope', 'completedOn', 'planId', 'occurrenceOn', 'eventType', 'eventHarvest'])
        && d.schemaVersion == 1 && text(d.title) && d.notes is string && d.notes.size() <= 10000
        && d.createdAt is timestamp && d.status in ['open', 'completed', 'cancelled', 'skipped']
        && (d.dueDate == null || date(d.dueDate))
        && (d.get('completedOn', null) == null || (d.status == 'completed' && date(d.completedOn)))
        && d.get('groupScope', '') is string && d.get('groupScope', '').size() <= 500
        && (d.get('groupId', null) == null || (d.groupId is string && uuid(d.groupId) && (d.itemId != null || d.get('sectionId', null) != null || d.get('cropId', null) != null)))
        && (d.get('planId',null)==null || (d.planId is string && uuid(d.planId) && exists(/databases/$(database)/documents/properties/$(propertyId)/taskPlans/$(d.planId))))
        && (d.get('occurrenceOn',null)==null || date(d.occurrenceOn))
        && (d.get('eventType',null)==null || activityType(d.eventType))
        && (d.get('eventType',null)!='harvest' || validHarvest({'harvest':d.get('eventHarvest',null)}))
        && validTaskTarget(d, propertyId);
    }
    function validTaskTarget(d, propertyId) {
      let section = d.get('sectionId', null);
      let crop = d.get('cropId', null);
      return (d.itemId == null && section == null && crop == null)
        || (d.itemId is string && uuid(d.itemId) && section == null && crop == null
          && (d.get('groupId', null) != null || exists(/databases/$(database)/documents/properties/$(propertyId)/items/$(d.itemId))))
        || (d.itemId == null && section is string && uuid(section) && crop == null && (d.get('groupId', null) != null || exists(/databases/$(database)/documents/properties/$(propertyId)/sections/$(section))))
        || (d.itemId == null && section == null && crop is string && uuid(crop) && (d.get('groupId', null) != null || exists(/databases/$(database)/documents/properties/$(propertyId)/crops/$(crop))));
    }
    function pointAt(points, index) { return points.size() <= index || points[index] is latlng; }
    function validIconRef(d, propertyId) {
      return d.get('customIconId',null)==null || (d.customIconId is string && uuid(d.customIconId)
        && exists(/databases/$(database)/documents/properties/$(propertyId)/icons/$(d.customIconId)));
    }
    function validTaxon(d, propertyId) {
      return d.keys().hasAll(['schemaVersion','name','rank','parentId','symbol'])
        && d.keys().hasOnly(['schemaVersion','name','rank','parentId','symbol','customIconId','scientificName','iconOverride'])
        && d.schemaVersion==1 && text(d.name)
        && d.rank in ['group','genus','species','cultivar']
        && ((d.rank=='group' && d.parentId==null) || (d.rank!='group' && d.parentId is string && uuid(d.parentId)))
        && d.symbol in ['tree','apple','pear','berry','flower','citrus','nut','vine','unknown']
        && (d.get('scientificName',null)==null || (d.scientificName is string && d.scientificName.size()<=500))
        && (d.get('iconOverride',null)==null || d.iconOverride is bool)
        && validIconRef(d, propertyId);
    }
    function validSection(d, propertyId) {
      return d.keys().hasAll(['schemaVersion','name','kind','parentId','notes','createdAt','vertices'])
        && d.keys().hasOnly(['schemaVersion','name','kind','parentId','notes','createdAt','vertices','color','symbol','customIconId'])
        && d.schemaVersion == 1 && text(d.name) && d.notes is string && d.notes.size() <= 10000 && d.createdAt is timestamp
        && (d.get('color',null)==null || (d.color is int && d.color >= 0 && d.color <= 4294967295))
        && (d.get('symbol',null)==null || d.symbol in ['tree','apple','pear','berry','flower','citrus','nut','vine','unknown'])
        && validIconRef(d, propertyId)
        && d.kind in ['area','row'] && d.vertices is list && d.vertices.size() <= 40
        && d.vertices.size() >= (d.kind == 'row' ? 2 : 3)
        && (d.parentId == null || (d.parentId is string && uuid(d.parentId)
          && get(/databases/$(database)/documents/properties/$(propertyId)/sections/$(d.parentId)).data.kind in ['area','bed']))
        && pointAt(d.vertices, 0)
        && pointAt(d.vertices, 1)
        && pointAt(d.vertices, 2)
        && pointAt(d.vertices, 3)
        && pointAt(d.vertices, 4)
        && pointAt(d.vertices, 5)
        && pointAt(d.vertices, 6)
        && pointAt(d.vertices, 7)
        && pointAt(d.vertices, 8)
        && pointAt(d.vertices, 9)
        && pointAt(d.vertices, 10)
        && pointAt(d.vertices, 11)
        && pointAt(d.vertices, 12)
        && pointAt(d.vertices, 13)
        && pointAt(d.vertices, 14)
        && pointAt(d.vertices, 15)
        && pointAt(d.vertices, 16)
        && pointAt(d.vertices, 17)
        && pointAt(d.vertices, 18)
        && pointAt(d.vertices, 19)
        && pointAt(d.vertices, 20)
        && pointAt(d.vertices, 21)
        && pointAt(d.vertices, 22)
        && pointAt(d.vertices, 23)
        && pointAt(d.vertices, 24)
        && pointAt(d.vertices, 25)
        && pointAt(d.vertices, 26)
        && pointAt(d.vertices, 27)
        && pointAt(d.vertices, 28)
        && pointAt(d.vertices, 29)
        && pointAt(d.vertices, 30)
        && pointAt(d.vertices, 31)
        && pointAt(d.vertices, 32)
        && pointAt(d.vertices, 33)
        && pointAt(d.vertices, 34)
        && pointAt(d.vertices, 35)
        && pointAt(d.vertices, 36)
        && pointAt(d.vertices, 37)
        && pointAt(d.vertices, 38)
        && pointAt(d.vertices, 39);
    }
    function validCrop(d, propertyId) {
      return d.keys().hasAll(['schemaVersion','sectionId','taxonId','label','season','notes','plantedOn','harvestedOn','status','createdAt'])
        && d.keys().hasOnly(['schemaVersion','sectionId','taxonId','label','season','notes','plantedOn','harvestedOn','status','createdAt','lifeCycle'])
        && d.schemaVersion == 1 && d.sectionId is string && uuid(d.sectionId) && d.taxonId is string && uuid(d.taxonId)
        && exists(/databases/$(database)/documents/properties/$(propertyId)/sections/$(d.sectionId))
        && d.get('lifeCycle','annual') in ['annual','perennial']
        && text(d.label) && text(d.season) && d.notes is string && d.notes.size() <= 10000 && d.createdAt is timestamp
        && (d.plantedOn == null || date(d.plantedOn)) && (d.harvestedOn == null || date(d.harvestedOn))
        && d.status in ['growing','harvested','ended'] && (d.status != 'harvested' || d.harvestedOn != null);
    }
    function validHarvest(d) {
      return d.harvest is map && d.harvest.keys().hasAll(['quantity', 'unit'])
        && d.harvest.keys().hasOnly(['quantity', 'unit'])
        && d.harvest.quantity is number && d.harvest.quantity > 0
        && d.harvest.quantity <= 1000000000000
        && d.harvest.unit in ['kg', 'g', 'lb', 'count']
        && (d.harvest.unit != 'count' || d.harvest.quantity == int(d.harvest.quantity));
    }
    function validEvent(d) {
      return d.keys().hasAll(['schemaVersion', 'authorId', 'type', 'occurredAt', 'activityDate', 'recordedAt', 'notes'])
        && d.keys().hasOnly(['schemaVersion', 'authorId', 'type', 'occurredAt', 'activityDate', 'recordedAt', 'notes', 'harvest','taskId'])
        && d.schemaVersion == 1 && d.authorId is string
        && d.type in ['planting', 'bloom', 'pruning', 'fertilizing', 'spraying', 'pestsDisease', 'watering', 'harvest', 'removal', 'note', 'photo', 'budBreak', 'firstBloom', 'fullBloom', 'petalFall', 'fruitSet', 'pest', 'disease', 'damage', 'harvestStart', 'harvestEnd', 'died', 'observation']
        && d.occurredAt is timestamp && d.recordedAt is timestamp
        && d.activityDate is string && d.activityDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && (d.get('taskId',null)==null || (d.taskId is string && uuid(d.taskId)))
        && d.notes is string && d.notes.size() <= 10000
        && ((d.type == 'harvest' && validHarvest(d)) || (d.type != 'harvest' && !('harvest' in d)));
    }
    function activityType(value) {
      return value in ['planting','bloom','pruning','fertilizing','spraying','pestsDisease','watering','harvest','removal','note','photo','budBreak','firstBloom','fullBloom','petalFall','fruitSet','pest','disease','damage','harvestStart','harvestEnd','died','observation'];
    }
    function validPlan(d,propertyId) {
      return d.keys().hasAll(['schemaVersion','title','target','createdAt','notes','repeat'])
        && d.keys().hasOnly(['schemaVersion','title','target','createdAt','notes','repeat','itemId','sectionId','cropId','taxonId','sectionKind','dueDate','eventType','eventHarvest','anchorOn'])
        && d.schemaVersion==1 && text(d.title) && d.notes is string && d.notes.size()<=10000 && d.createdAt is timestamp
        && d.target in ['plant','plants','section','sections','crop','crops','property']
        && d.repeat in ['none','daily','weekly','monthly','yearly']
        && (d.get('sectionKind','row') in ['area','row'])
        && (d.get('dueDate',null)==null || date(d.dueDate))
        && (d.get('anchorOn',null)==null || date(d.anchorOn))
        && (d.get('taxonId',null)==null || (d.taxonId is string && uuid(d.taxonId)))
        && (d.get('itemId',null)==null || (d.itemId is string && uuid(d.itemId) && exists(/databases/$(database)/documents/properties/$(propertyId)/items/$(d.itemId))))
        && (d.get('sectionId',null)==null || (d.sectionId is string && uuid(d.sectionId) && exists(/databases/$(database)/documents/properties/$(propertyId)/sections/$(d.sectionId))))
        && (d.get('cropId',null)==null || (d.cropId is string && uuid(d.cropId) && exists(/databases/$(database)/documents/properties/$(propertyId)/crops/$(d.cropId))))
        && (d.get('eventType',null)==null || activityType(d.eventType))
        && (d.get('eventType',null)!='harvest' || validHarvest({'harvest':d.get('eventHarvest',null)}));
    }
    match /properties/{propertyId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || member(propertyId));
      allow create: if signedIn() && uuid(propertyId)
        && request.resource.data.keys().hasAll(['schemaVersion', 'name', 'ownerId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'name', 'ownerId', 'createdAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.ownerId == request.auth.uid
        && text(request.resource.data.name) && request.resource.data.createdAt is timestamp;
      allow update: if owner(propertyId) && text(request.resource.data.name) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
      match /members/{userId} {
        allow read: if reader(propertyId);
        allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['role','invitationId'])
          && request.resource.data.role in ['editor','viewer']
          && invited(request.resource.data.invitationId,propertyId)
          && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role;
        allow update: if owner(propertyId) && request.resource.data.role in ['editor','viewer']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
        allow delete: if owner(propertyId);
      }
      match /foraging/{resourceId} {
        allow read: if reader(propertyId);
        allow create, update: if writer(propertyId) && uuid(resourceId)
          && ((request.resource.data.keys().hasOnly(['id','name','taxonId','latitude','longitude','createdAt','startMonth','endMonth','public','notes'])
            && request.resource.data.id==resourceId && text(request.resource.data.name)
            && uuid(request.resource.data.taxonId) && request.resource.data.latitude is number
            && request.resource.data.latitude>=-90 && request.resource.data.latitude<=90
            && request.resource.data.longitude is number && request.resource.data.longitude>=-180 && request.resource.data.longitude<=180
            && request.resource.data.startMonth is int && request.resource.data.startMonth>=1 && request.resource.data.startMonth<=12
            && request.resource.data.endMonth is int && request.resource.data.endMonth>=1 && request.resource.data.endMonth<=12
            && request.resource.data.public is bool && request.resource.data.notes is string && request.resource.data.notes.size()<=10000
            && request.resource.data.createdAt is string)
          || (request.resource.data.keys().hasOnly(['id','parentId','observation','date'])
            && request.resource.data.id==resourceId && uuid(request.resource.data.parentId)
            && exists(/databases/$(database)/documents/properties/$(propertyId)/foraging/$(request.resource.data.parentId))
            && request.resource.data.observation is string && request.resource.data.observation.size()>0 && request.resource.data.observation.size()<=10000
            && date(request.resource.data.date)));
        allow delete: if writer(propertyId);
      }
      match /reminder/{reminderId} {
        allow read: if reader(propertyId);
        allow create, update: if writer(propertyId) && uuid(reminderId)
          && request.resource.data.keys().hasOnly(['id','days']) && request.resource.data.id==reminderId
          && request.resource.data.days is int && request.resource.data.days>=0 && request.resource.data.days<=365;
        allow delete: if writer(propertyId);
      }
      match /activityRevision/{revisionId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(revisionId)
          && request.resource.data.keys().hasOnly(['id','itemId','eventId','action','changedAt','event'])
          && request.resource.data.id==revisionId && uuid(request.resource.data.itemId) && uuid(request.resource.data.eventId)
          && request.resource.data.action in ['edited','deleted'] && request.resource.data.changedAt is string
          && request.resource.data.event == get(/databases/$(database)/documents/properties/$(propertyId)/items/$(request.resource.data.itemId)/events/$(request.resource.data.eventId)).data;
        allow update: if false;
        allow delete: if owner(propertyId) && !exists(/databases/$(database)/documents/properties/$(propertyId)/items/$(resource.data.itemId));
      }
      match /photo/{photoId} {
        function photo(d) {
          return d.keys().hasOnly(['id','itemId','authorId','createdAt','storagePath','image','thumbnail','state','error'])
            && d.id==photoId && uuid(d.itemId) && d.authorId is string && d.createdAt is string
            && d.storagePath == 'properties/'+propertyId+'/items/'+d.itemId+'/photos/'+photoId+'.jpg'
            && d.thumbnail is string && d.thumbnail.size()<=43692
            && (d.image==null || (d.image is string && d.image.size()<=699052))
            && d.state in ['pending','uploaded'] && (d.get('error',null)==null || (d.error is string && d.error.size()<=500));
        }
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(photoId) && photo(request.resource.data) && request.resource.data.authorId==request.auth.uid;
        allow update: if writer(propertyId) && photo(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','image','error']);
        allow delete: if writer(propertyId);
      }
      match /sections/{sectionId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(sectionId) && request.resource.data.parentId != sectionId && validSection(request.resource.data, propertyId);
        allow update: if writer(propertyId) && validSection(request.resource.data, propertyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','notes','vertices','color','symbol','customIconId','kind'])
          && (request.resource.data.kind == resource.data.kind || (resource.data.kind=='bed' && request.resource.data.kind=='area'));
        allow delete: if writer(propertyId);
      }
      match /crops/{cropId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(cropId) && validCrop(request.resource.data, propertyId) && request.resource.data.status == 'growing';
        allow update: if writer(propertyId) && validCrop(request.resource.data, propertyId)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifeCycle'])
            && request.resource.data.get('lifeCycle','annual') != resource.data.get('lifeCycle','annual'))
          || (resource.data.status != 'ended' && request.resource.data.status != 'growing'
            && request.resource.data.get('lifeCycle','annual') == resource.data.get('lifeCycle','annual')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','harvestedOn','lifeCycle'])));
        allow delete: if writer(propertyId);
      }
      match /cropHarvests/{harvestId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(harvestId)
          && request.resource.data.keys().hasAll(['schemaVersion','cropId','activityDate','notes','recordedAt','harvest'])
          && request.resource.data.keys().hasOnly(['schemaVersion','cropId','activityDate','notes','recordedAt','harvest'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.cropId is string && uuid(request.resource.data.cropId)
          && exists(/databases/$(database)/documents/properties/$(propertyId)/crops/$(request.resource.data.cropId))
          && date(request.resource.data.activityDate) && request.resource.data.recordedAt is timestamp
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 10000 && validHarvest(request.resource.data);
        allow update: if false;
        allow delete: if writer(propertyId);
      }
      match /taskPlans/{planId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(planId) && validPlan(request.resource.data,propertyId);
        allow update: if writer(propertyId) && validPlan(request.resource.data,propertyId) && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if writer(propertyId);
      }
      match /tasks/{taskId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(taskId) && validTask(request.resource.data, propertyId);
        allow update: if writer(propertyId) && validTask(request.resource.data, propertyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedOn'])
          || (writer(propertyId) && validTask(request.resource.data,propertyId) && resource.data.status=='open'
          && request.resource.data.status=='open' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','notes','dueDate','eventType','eventHarvest']));
        allow delete: if writer(propertyId);
      }
      match /icons/{iconId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(iconId)
          && request.resource.data.keys().hasOnly(['schemaVersion','name','png'])
          && request.resource.data.schemaVersion==1 && text(request.resource.data.name)
          && request.resource.data.png is string && request.resource.data.png.size()<=43692
          && request.resource.data.png.matches('iVBORw0KGgo.*');
        allow update: if writer(propertyId) && resource.data.get('deleted',false)==false
          && ((text(request.resource.data.name)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
          || (request.resource.data.keys().hasOnly(['schemaVersion','name','png','deleted'])
            && request.resource.data.schemaVersion==1 && request.resource.data.deleted==true
            && request.resource.data.name=='Deleted icon' && request.resource.data.png==''));
        allow delete: if false;
      }
      match /taxa/{taxonId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(taxonId) && validTaxon(request.resource.data,propertyId);
        allow update: if writer(propertyId) && validTaxon(request.resource.data,propertyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','symbol','customIconId','scientificName','iconOverride']);
        allow delete: if false;
      }
      match /items/{itemId} {
        allow read: if reader(propertyId);
        allow create: if writer(propertyId) && uuid(itemId) && validItem(request.resource.data, propertyId);
        allow update: if writer(propertyId) && validItem(request.resource.data, propertyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','taxonId','location','plantedOn','accuracyMeters','rowOrder','rootstock','nursery','notes','status','sectionId','lifeCycle','season']);
        allow delete: if writer(propertyId);
        match /photos/{photoId} { allow read, delete: if writer(propertyId); allow create, update: if false; }
        match /events/{eventId} {
          allow read: if reader(propertyId);
          allow create: if writer(propertyId) && uuid(eventId)
            && getAfter(/databases/$(database)/documents/properties/$(propertyId)/items/$(itemId)).data.kind == 'managedPlant'
            && validEvent(request.resource.data) && request.resource.data.authorId == request.auth.uid;
          allow update: if writer(propertyId) && validEvent(request.resource.data)
            && request.resource.data.authorId==resource.data.authorId && request.resource.data.recordedAt==resource.data.recordedAt
            && request.resource.data.get('taskId',null)==resource.data.get('taskId',null);
          allow delete: if writer(propertyId);
        }
      }
    }
    match /invitations/{invitationId} {
      allow read: if signedIn() && ((request.auth.token.email_verified==true && resource.data.email==request.auth.token.email.lower()) || resource.data.ownerId==request.auth.uid);
      allow create: if signedIn() && uuid(invitationId)
        && request.resource.data.keys().hasOnly(['orchard','orchardName','ownerId','email','role','createdAt'])
        && owner(request.resource.data.orchard) && request.resource.data.ownerId==request.auth.uid
        && text(request.resource.data.orchardName) && request.resource.data.email is string
        && request.resource.data.email.size()<=254 && request.resource.data.email==request.resource.data.email.lower()
        && request.resource.data.role in ['editor','viewer'] && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerId==request.auth.uid || (request.auth.token.email_verified==true && resource.data.email==request.auth.token.email.lower()));
    }
    match /users/{userId}/orchards/{propertyId} {
      allow read, delete: if signedIn() && request.auth.uid==userId;
      allow create: if signedIn() && request.auth.uid==userId
        && request.resource.data.keys().hasOnly(['invitationId'])
        && invited(request.resource.data.invitationId,propertyId)
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)/members/$(userId)).data.invitationId==request.resource.data.invitationId;
      allow update: if false;
    }
    match /publicResources/{resourceId} {
      allow read: if signedIn();
      allow create, update: if writer(request.resource.data.orchard)
        && request.resource.data.keys().hasOnly(['id','orchard','name','taxonId','latitude','longitude','startMonth','endMonth'])
        && resourceId==request.resource.data.orchard+'_'+request.resource.data.id
        && getAfter(/databases/$(database)/documents/properties/$(request.resource.data.orchard)/foraging/$(request.resource.data.id)).data.public==true
        && request.resource.data.name==getAfter(/databases/$(database)/documents/properties/$(request.resource.data.orchard)/foraging/$(request.resource.data.id)).data.name
        && request.resource.data.latitude==getAfter(/databases/$(database)/documents/properties/$(request.resource.data.orchard)/foraging/$(request.resource.data.id)).data.latitude
        && request.resource.data.longitude==getAfter(/databases/$(database)/documents/properties/$(request.resource.data.orchard)/foraging/$(request.resource.data.id)).data.longitude;
      allow delete: if signedIn() && (!exists(/databases/$(database)/documents/publicResources/$(resourceId)) || writer(resource.data.orchard));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
